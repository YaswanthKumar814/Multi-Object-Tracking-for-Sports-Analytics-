__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/
.claude/

# Model weights (downloaded on first run)
weights/*
!weights/.gitkeep
*.pt

# Datasets (see DATASETS.md for how to obtain the subsets used)
data/

# Application outputs: only the final, compressed result videos and their
# track/summary files are kept in git (re-encoded to small H.264).
outputs/*
!outputs/uvy_soccer_V0[24]_tracked_h264.mp4
!outputs/uvy_soccer_V0[24]_tracks.csv
!outputs/uvy_soccer_V0[24]_summary.json
*.mp4
!outputs/uvy_soccer_V0[24]_tracked_h264.mp4
*.avi

# Experiment outputs: keep the small result files (metrics, plots, database,
# MOT text files); ignore bulky or regenerable ones.
results/cache/
results/logs/
results/tracks/tuning/
results/demo/*.mp4
